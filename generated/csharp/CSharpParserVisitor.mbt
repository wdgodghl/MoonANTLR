///|
pub fn[T] CSharpParserVisitor::visit(
  self : CSharpParserVisitor[T],
  node : @runtime.RuleContext,
) -> T {
  let values = node.children.map(child => {
    match child {
      @runtime.TokenChild(token) => (self.terminal)(token)
      @runtime.RuleChild(context) => self.visit(context)
    }
  })
  match node.name {
    "compilation_unit" => {
      let context = CSharpParserCompilation_unitContext::{ node, }
      (self.visit_compilation_unit)(context, values)
    }
    "namespace_or_type_name" => {
      let context = CSharpParserNamespace_or_type_nameContext::{ node, }
      (self.visit_namespace_or_type_name)(context, values)
    }
    "type_" => {
      let context = CSharpParserType_Context::{ node, }
      (self.visit_type_)(context, values)
    }
    "base_type" => {
      let context = CSharpParserBase_typeContext::{ node, }
      (self.visit_base_type)(context, values)
    }
    "tuple_type" => {
      let context = CSharpParserTuple_typeContext::{ node, }
      (self.visit_tuple_type)(context, values)
    }
    "tuple_element" => {
      let context = CSharpParserTuple_elementContext::{ node, }
      (self.visit_tuple_element)(context, values)
    }
    "simple_type" => {
      let context = CSharpParserSimple_typeContext::{ node, }
      (self.visit_simple_type)(context, values)
    }
    "numeric_type" => {
      let context = CSharpParserNumeric_typeContext::{ node, }
      (self.visit_numeric_type)(context, values)
    }
    "integral_type" => {
      let context = CSharpParserIntegral_typeContext::{ node, }
      (self.visit_integral_type)(context, values)
    }
    "floating_point_type" => {
      let context = CSharpParserFloating_point_typeContext::{ node, }
      (self.visit_floating_point_type)(context, values)
    }
    "class_type" => {
      let context = CSharpParserClass_typeContext::{ node, }
      (self.visit_class_type)(context, values)
    }
    "type_argument_list" => {
      let context = CSharpParserType_argument_listContext::{ node, }
      (self.visit_type_argument_list)(context, values)
    }
    "argument_list" => {
      let context = CSharpParserArgument_listContext::{ node, }
      (self.visit_argument_list)(context, values)
    }
    "argument" => {
      let context = CSharpParserArgumentContext::{ node, }
      (self.visit_argument)(context, values)
    }
    "expression" => {
      let context = CSharpParserExpressionContext::{ node, }
      (self.visit_expression)(context, values)
    }
    "non_assignment_expression" => {
      let context = CSharpParserNon_assignment_expressionContext::{ node, }
      (self.visit_non_assignment_expression)(context, values)
    }
    "assignment" => {
      let context = CSharpParserAssignmentContext::{ node, }
      (self.visit_assignment)(context, values)
    }
    "assignment_operator" => {
      let context = CSharpParserAssignment_operatorContext::{ node, }
      (self.visit_assignment_operator)(context, values)
    }
    "conditional_expression" => {
      let context = CSharpParserConditional_expressionContext::{ node, }
      (self.visit_conditional_expression)(context, values)
    }
    "null_coalescing_expression" => {
      let context = CSharpParserNull_coalescing_expressionContext::{ node, }
      (self.visit_null_coalescing_expression)(context, values)
    }
    "conditional_or_expression" => {
