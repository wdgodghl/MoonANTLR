  rule~ : (@runtime.RuleContext, Array[T]) -> T,
) -> CSharpParserVisitor[T] {
  {
    terminal,
    visit_compilation_unit: (context, children) => rule(context.raw(), children),
    visit_namespace_or_type_name: (context, children) => {
      rule(context.raw(), children)
    },
    visit_type_: (context, children) => rule(context.raw(), children),
    visit_base_type: (context, children) => rule(context.raw(), children),
    visit_tuple_type: (context, children) => rule(context.raw(), children),
