///|
pub fn CSharpParserPrimary_expression_startContext::alternative(
  self : CSharpParserPrimary_expression_startContext,
) -> String? {
  if self.node.path.any(state => {
      [891, 892, 894, 895, 896, 897, 899, 900, 902].contains(state)
    }) {
    return Some("anonymousMethodExpression")
  }
  if self.node.path.any(state => {
      [813, 814, 815, 816, 817, 819, 820, 821, 823].contains(state)
    }) {
    return Some("baseAccessExpression")
  }
  if self.node.path.any(state => [874, 875, 876, 877].contains(state)) {
    return Some("checkedExpression")
  }
  if self.node.path.any(state => [884, 885, 886, 887, 889].contains(state)) {
    return Some("defaultValueExpression")
  }
  if self.node.path.any(state => [811].contains(state)) {
    return Some("literalAccessExpression")
  }
  if self.node.path.any(state => [800].contains(state)) {
    return Some("literalExpression")
  }
  if self.node.path.any(state => [809, 810].contains(state)) {
    return Some("memberAccessExpression")
  }
  if self.node.path.any(state => {
      [908, 909, 910, 911, 913, 915, 918, 919].contains(state)
    }) {
    return Some("nameofExpression")
  }
  if self.node.path.any(state => {
      [
        825, 826, 827, 828, 829, 830, 831, 832, 833, 835, 838, 839, 841, 842, 844,
        846, 848, 850, 851, 852, 854,
      ].contains(state)
    }) {
    return Some("objectCreationExpression")
  }
  if self.node.path.any(state => [805, 806, 807].contains(state)) {
    return Some("parenthesisExpressions")
  }
  if self.node.path.any(state => [801, 802, 803].contains(state)) {
    return Some("simpleNameExpression")
  }
  if self.node.path.any(state => [903, 904, 905, 906].contains(state)) {
    return Some("sizeofExpression")
  }
  if self.node.path.any(state => [812].contains(state)) {
    return Some("thisReferenceExpression")
  }
  if self.node.path.any(state => {
      [856, 857, 858, 859, 860, 862, 864].contains(state)
    }) {
    return Some("tupleExpression")
  }
  if self.node.path.any(state => {
      [866, 867, 868, 869, 870, 871, 873].contains(state)
    }) {
    return Some("typeofExpression")
  }
  if self.node.path.any(state => [879, 880, 881, 882].contains(state)) {
    return Some("uncheckedExpression")
  }
  None
}

