///|
pub fn CSharpParserSimple_embedded_statementContext::alternative(
  self : CSharpParserSimple_embedded_statementContext,
) -> String? {
  if self.node.path.any(state => [1357, 1358].contains(state)) {
    return Some("breakStatement")
  }
  if self.node.path.any(state => [1388, 1389].contains(state)) {
    return Some("checkedStatement")
  }
  if self.node.path.any(state => [1359, 1360].contains(state)) {
    return Some("continueStatement")
  }
  if self.node.path.any(state => {
      [1322, 1323, 1324, 1325, 1326, 1327, 1328].contains(state)
    }) {
    return Some("doStatement")
  }
  if self.node.path.any(state => [1291, 1292].contains(state)) {
    return Some("expressionStatement")
  }
  if self.node.path.any(state => {
      [1413, 1414, 1415, 1416, 1417, 1418].contains(state)
    }) {
    return Some("fixedStatement")
  }
  if self.node.path.any(state => {
      [1330, 1331, 1332, 1333, 1335, 1336, 1337, 1339, 1340, 1341, 1343, 1344].contains(
        state,
      )
    }) {
    return Some("forStatement")
  }
  if self.node.path.any(state => {
      [1345, 1346, 1348, 1349, 1350, 1351, 1352, 1353, 1354, 1355].contains(
        state,
      )
    }) {
    return Some("foreachStatement")
  }
  if self.node.path.any(state => {
      [1361, 1362, 1363, 1364, 1365, 1366, 1368].contains(state)
    }) {
    return Some("gotoStatement")
  }
  if self.node.path.any(state => {
      [1294, 1295, 1296, 1297, 1298, 1299, 1300, 1301].contains(state)
    }) {
    return Some("ifStatement")
  }
  if self.node.path.any(state => [1392, 1393, 1394, 1395, 1396].contains(state)) {
    return Some("lockStatement")
  }
  if self.node.path.any(state => [1369, 1370, 1371, 1373].contains(state)) {
    return Some("returnStatement")
  }
  if self.node.path.any(state => {
      [1303, 1304, 1305, 1306, 1307, 1308, 1309, 1311, 1314].contains(state)
    }) {
    return Some("switchStatement")
  }
  if self.node.path.any(state => [1290].contains(state)) {
    return Some("theEmptyStatement")
  }
  if self.node.path.any(state => [1374, 1375, 1376, 1378].contains(state)) {
    return Some("throwStatement")
  }
  if self.node.path.any(state => {
      [1379, 1380, 1381, 1382, 1383, 1385, 1386].contains(state)
    }) {
    return Some("tryStatement")
  }
  if self.node.path.any(state => [1390, 1391].contains(state)) {
    return Some("uncheckedStatement")
  }
  if self.node.path.any(state => [1411, 1412].contains(state)) {
    return Some("unsafeStatement")
  }
  if self.node.path.any(state => [1398, 1399, 1400, 1401, 1402].contains(state)) {
    return Some("usingStatement")
  }
  if self.node.path.any(state => [1316, 1317, 1318, 1319, 1320].contains(state)) {
    return Some("whileStatement")
  }
  if self.node.path.any(state => {
      [1404, 1405, 1406, 1407, 1408, 1410].contains(state)
    }) {
    return Some("yieldStatement")
  }
  None
}

