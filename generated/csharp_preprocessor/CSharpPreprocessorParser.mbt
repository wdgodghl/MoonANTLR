    }) {
    return Some("preprocessorLine")
  }
  if self.node.path.any(state => [75, 76, 77, 78].contains(state)) {
    return Some("preprocessorNullable")
  }
  if self.node.path.any(state => [70, 71, 72, 73].contains(state)) {
    return Some("preprocessorPragma")
  }
  if self.node.path.any(state => {
      [56, 57, 58, 60, 61, 63, 64, 65, 67, 68].contains(state)
    }) {
    return Some("preprocessorRegion")
  }
