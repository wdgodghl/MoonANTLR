  self : CSharpPreprocessorParserPreprocessor_directiveContext,
) -> String? {
  if self.node.path.any(state => {
      [16, 17, 18, 19, 21, 22, 23, 24, 26, 27, 28, 30, 31, 32].contains(state)
    }) {
    return Some("preprocessorConditional")
