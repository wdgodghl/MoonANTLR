  if self.node.path.any(state => [6, 7, 8, 9, 11, 12, 13, 14].contains(state)) {
    return Some("preprocessorDeclaration")
  }
  if self.node.path.any(state => {
      [46, 47, 48, 49, 51, 52, 53, 54].contains(state)
    }) {
    return Some("preprocessorDiagnostic")
  }
  if self.node.path.any(state => {
