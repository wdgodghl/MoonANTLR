) -> ExprExpressionContext {
  { node: self.node, }
}

///|
pub fn ExprExpressionContext::as_doNotEqual(
  self : ExprExpressionContext,
) -> ExprDoNotEqualContext? {
  if self.alternative() == Some("doNotEqual") {
    Some({ node: self.node, })
  } else {
    None
  }
}

