///|
pub fn ExprExpressionContext::alternative(
  self : ExprExpressionContext,
) -> String? {
  if self.node.path.any(state => [86, 87, 88].contains(state)) {
    return Some("doAnd")
  }
  if self.node.path.any(state => [56, 57, 58].contains(state)) {
    return Some("doDivide")
  }
  if self.node.path.any(state => [68, 69, 70].contains(state)) {
    return Some("doEqual")
  }
  if self.node.path.any(state => {
      [7, 8, 9, 10, 11, 12, 13, 15, 18].contains(state)
    }) {
    return Some("doFunction")
  }
  if self.node.path.any(state => [74, 75, 76].contains(state)) {
    return Some("doGreather")
  }
  if self.node.path.any(state => [77, 78, 79].contains(state)) {
    return Some("doGreatherEqual")
  }
  if self.node.path.any(state => {
      [92, 93, 94, 95, 96, 97, 98, 100, 103].contains(state)
    }) {
    return Some("doIn")
  }
  if self.node.path.any(state => [80, 81, 82].contains(state)) {
    return Some("doLesser")
  }
  if self.node.path.any(state => [83, 84, 85].contains(state)) {
    return Some("doLesserEqual")
  }
  if self.node.path.any(state => [62, 63, 64].contains(state)) {
    return Some("doMinus")
  }
  if self.node.path.any(state => [59, 60, 61].contains(state)) {
    return Some("doModulo")
  }
  if self.node.path.any(state => [53, 54, 55].contains(state)) {
    return Some("doMultipy")
  }
  if self.node.path.any(state => [26, 27].contains(state)) {
    return Some("doNegate")
  }
  if self.node.path.any(state => [24, 25].contains(state)) {
    return Some("doNot")
  }
  if self.node.path.any(state => [71, 72, 73].contains(state)) {
    return Some("doNotEqual")
  }
  if self.node.path.any(state => [89, 90, 91].contains(state)) {
    return Some("doOr")
  }
  if self.node.path.any(state => [20, 21, 22].contains(state)) {
    return Some("doParenthesis")
  }
  if self.node.path.any(state => [65, 66, 67].contains(state)) {
    return Some("doPlus")
  }
  if self.node.path.any(state => [28, 29].contains(state)) {
    return Some("doPositiv")
  }
  if self.node.path.any(state => [50, 51, 52].contains(state)) {
    return Some("doPower")
  }
  if self.node.path.any(state => [30, 31, 32, 33, 34, 36, 39].contains(state)) {
    return Some("newArray")
  }
  if self.node.path.any(state => [44].contains(state)) {
    return Some("newDateTime")
  }
  if self.node.path.any(state => [42].contains(state)) {
    return Some("newFalseBoolean")
  }
  if self.node.path.any(state => [45].contains(state)) {
    return Some("newIdentifier")
  }
  if self.node.path.any(state => [47].contains(state)) {
    return Some("newNull")
  }
  if self.node.path.any(state => [43].contains(state)) {
    return Some("newNumber")
  }
  if self.node.path.any(state => [46].contains(state)) {
    return Some("newString")
  }
  if self.node.path.any(state => [41].contains(state)) {
    return Some("newTrueBoolean")
  }
  None
}
