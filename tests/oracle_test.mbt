}

///|
test "Java oracle Json 010" {
  let grammar = @json.grammar()
  let source = "\r\n {\"x\": -1.2E-3} \t"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (object \"{\" (pair \"\\\"x\\\"\" \":\" (value \"-1.2E-3\")) \"}\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "{", 3, 4, 2, 1, 0),
    (10, "\"x\"", 4, 7, 2, 2, 0),
    (7, ":", 7, 8, 2, 5, 0),
    (11, "-1.2E-3", 9, 16, 2, 7, 0),
    (6, "}", 16, 17, 2, 14, 0),
    (-1, "<EOF>", 19, 19, 2, 17, 0),
  ])
}

