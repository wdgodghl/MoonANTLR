///|
test "Java oracle Decisions 023" {
  let grammar = @decisions.grammar()
  let source = "p a x; q a x y; p a x; q a x y; "
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (item \"p\" (choice \"a\") \"x\" \";\") (item \"q\" (choice \"a\" \"x\") \"y\" \";\") (item \"p\" (choice \"a\") \"x\" \";\") (item \"q\" (choice \"a\" \"x\") \"y\" \";\") <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (1, "p", 0, 1, 1, 0, 0),
    (6, "a", 2, 3, 1, 2, 0),
    (2, "x", 4, 5, 1, 4, 0),
    (3, ";", 5, 6, 1, 5, 0),
    (4, "q", 7, 8, 1, 7, 0),
    (6, "a", 9, 10, 1, 9, 0),
    (2, "x", 11, 12, 1, 11, 0),
    (5, "y", 13, 14, 1, 13, 0),
    (3, ";", 14, 15, 1, 14, 0),
    (1, "p", 16, 17, 1, 16, 0),
    (6, "a", 18, 19, 1, 18, 0),
    (2, "x", 20, 21, 1, 20, 0),
    (3, ";", 21, 22, 1, 21, 0),
    (4, "q", 23, 24, 1, 23, 0),
    (6, "a", 25, 26, 1, 25, 0),
    (2, "x", 27, 28, 1, 27, 0),
    (5, "y", 29, 30, 1, 29, 0),
    (3, ";", 30, 31, 1, 30, 0),
    (-1, "<EOF>", 32, 32, 1, 32, 0),
  ])
}

