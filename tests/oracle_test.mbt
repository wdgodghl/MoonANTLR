test "Java oracle Decisions 010" {
  let grammar = @decisions.grammar()
  let source = "z foo !;"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (item (longChoice \"z\" \"foo\" \"!\") \";\") <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (7, "z", 0, 1, 1, 0, 0),
    (11, "foo", 2, 5, 1, 2, 0),
    (8, "!", 6, 7, 1, 6, 0),
    (3, ";", 7, 8, 1, 7, 0),
    (-1, "<EOF>", 8, 8, 1, 8, 0),
  ])
}

///|
test "Java oracle Decisions 011" {
  let grammar = @decisions.grammar()
  let source = "z foo bar ?;"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (item (longChoice \"z\" \"foo\" \"bar\" \"?\") \";\") <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (7, "z", 0, 1, 1, 0, 0),
    (11, "foo", 2, 5, 1, 2, 0),
    (11, "bar", 6, 9, 1, 6, 0),
    (9, "?", 10, 11, 1, 10, 0),
    (3, ";", 11, 12, 1, 11, 0),
    (-1, "<EOF>", 12, 12, 1, 12, 0),
  ])
}

///|
test "Java oracle Decisions 012" {
  let grammar = @decisions.grammar()
  let rejected = try {
    let _ = grammar.parse("z !;")
    false
  } catch {
    _ => true
  }
  assert_true(rejected)
}

///|
test "Java oracle Decisions 013" {
  let grammar = @decisions.grammar()
  let rejected = try {
    let _ = grammar.parse("p a x x x;")
    false
  } catch {
    _ => true
  }
  assert_true(rejected)
}

///|
test "Java oracle Decisions 014" {
  let grammar = @decisions.grammar()
  let source = "p a x; q a x y; p a x x; u;"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (item \"p\" (choice \"a\") \"x\" \";\") (item \"q\" (choice \"a\" \"x\") \"y\" \";\") (item \"p\" (choice \"a\" \"x\") \"x\" \";\") (item (either (first \"u\")) \";\") <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (1, "p", 0, 1, 1, 0, 0),
    (6, "a", 2, 3, 1, 2, 0),
    (2, "x", 4, 5, 1, 4, 0),
    (3, ";", 5, 6, 1, 5, 0),
    (4, "q", 7, 8, 1, 7, 0),
    (6, "a", 9, 10, 1, 9, 0),
    (2, "x", 11, 12, 1, 11, 0),
    (5, "y", 13, 14, 1, 13, 0),
    (3, ";", 14, 15, 1, 14, 0),
    (1, "p", 16, 17, 1, 16, 0),
    (6, "a", 18, 19, 1, 18, 0),
    (2, "x", 20, 21, 1, 20, 0),
    (2, "x", 22, 23, 1, 22, 0),
    (3, ";", 23, 24, 1, 23, 0),
    (10, "u", 25, 26, 1, 25, 0),
    (3, ";", 26, 27, 1, 26, 0),
    (-1, "<EOF>", 27, 27, 1, 27, 0),
  ])
}

