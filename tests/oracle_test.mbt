    (2, "\r\n", 29, 31, 1, 29, 0),
    (1, ",", 31, 32, 2, 0, 0),
    (3, "\"a\"\"b\"", 32, 38, 2, 1, 0),
    (1, ",", 38, 39, 2, 7, 0),
    (4, "中文😀", 39, 42, 2, 8, 0),
