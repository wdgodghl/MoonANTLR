  let source = "{\n  \"key0\": \"line\\n\\ttab\",\n  \"key1\": true,\n  \"key2\": true\n}"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value \"\\\"line\\\\n\\\\ttab\\\"\")) \",\" (pair \"\\\"key1\\\"\" \":\" (value \"true\")) \",\" (pair \"\\\"key2\\\"\" \":\" (value \"true\")) \"}\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "{", 0, 1, 1, 0, 0),
    (10, "\"key0\"", 4, 10, 2, 2, 0),
    (7, ":", 10, 11, 2, 8, 0),
    (10, "\"line\\n\\ttab\"", 12, 25, 2, 10, 0),
    (5, ",", 25, 26, 2, 23, 0),
    (10, "\"key1\"", 29, 35, 3, 2, 0),
    (7, ":", 35, 36, 3, 8, 0),
    (1, "true", 37, 41, 3, 10, 0),
    (5, ",", 41, 42, 3, 14, 0),
    (10, "\"key2\"", 45, 51, 4, 2, 0),
    (7, ":", 51, 52, 4, 8, 0),
    (1, "true", 53, 57, 4, 10, 0),
    (6, "}", 58, 59, 5, 0, 0),
    (-1, "<EOF>", 59, 59, 5, 1, 0),
  ])
}

