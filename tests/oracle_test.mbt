///|
test "Java oracle Precedence 000" {
  let grammar = @precedence.grammar()
  let source = "1+2*3"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (expression \"1\") \"+\" (expression (expression \"2\") \"*\" (expression \"3\"))) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (8, "1", 0, 1, 1, 0, 0),
    (4, "+", 1, 2, 1, 1, 0),
    (8, "2", 2, 3, 1, 2, 0),
    (2, "*", 3, 4, 1, 3, 0),
    (8, "3", 4, 5, 1, 4, 0),
    (-1, "<EOF>", 5, 5, 1, 5, 0),
  ])
}

///|
test "Java oracle Precedence 001" {
  let grammar = @precedence.grammar()
  let source = "(1+2)*3"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (expression \"(\" (expression (expression \"1\") \"+\" (expression \"2\")) \")\") \"*\" (expression \"3\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (6, "(", 0, 1, 1, 0, 0),
    (8, "1", 1, 2, 1, 1, 0),
    (4, "+", 2, 3, 1, 2, 0),
    (8, "2", 3, 4, 1, 3, 0),
    (7, ")", 4, 5, 1, 4, 0),
    (2, "*", 5, 6, 1, 5, 0),
    (8, "3", 6, 7, 1, 6, 0),
    (-1, "<EOF>", 7, 7, 1, 7, 0),
  ])
}

///|
test "Java oracle Precedence 002" {
  let grammar = @precedence.grammar()
  let source = " 12 / 3 - 2\n"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (expression (expression \"12\") \"/\" (expression \"3\")) \"-\" (expression \"2\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (8, "12", 1, 3, 1, 1, 0),
    (3, "/", 4, 5, 1, 4, 0),
    (8, "3", 6, 7, 1, 6, 0),
    (5, "-", 8, 9, 1, 8, 0),
    (8, "2", 10, 11, 1, 10, 0),
    (-1, "<EOF>", 12, 12, 2, 0, 0),
  ])
}

///|
test "Java oracle Precedence 003" {
  let grammar = @precedence.grammar()
  let source = "1-2-3"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (expression (expression \"1\") \"-\" (expression \"2\")) \"-\" (expression \"3\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (8, "1", 0, 1, 1, 0, 0),
    (5, "-", 1, 2, 1, 1, 0),
    (8, "2", 2, 3, 1, 2, 0),
    (5, "-", 3, 4, 1, 3, 0),
    (8, "3", 4, 5, 1, 4, 0),
    (-1, "<EOF>", 5, 5, 1, 5, 0),
  ])
}

///|
test "Java oracle Precedence 004" {
  let grammar = @precedence.grammar()
  let source = "1/(2+3)"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (expression \"1\") \"/\" (expression \"(\" (expression (expression \"2\") \"+\" (expression \"3\")) \")\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (8, "1", 0, 1, 1, 0, 0),
    (3, "/", 1, 2, 1, 1, 0),
    (6, "(", 2, 3, 1, 2, 0),
    (8, "2", 3, 4, 1, 3, 0),
    (4, "+", 4, 5, 1, 4, 0),
    (8, "3", 5, 6, 1, 5, 0),
    (7, ")", 6, 7, 1, 6, 0),
    (-1, "<EOF>", 7, 7, 1, 7, 0),
  ])
}

///|
test "Java oracle Precedence 005" {
  let grammar = @precedence.grammar()
  let source = "5"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression \"5\") <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (8, "5", 0, 1, 1, 0, 0),
    (-1, "<EOF>", 1, 1, 1, 1, 0),
  ])
}

///|
test "Java oracle Precedence 006" {
  let grammar = @precedence.grammar()
  let source = "((51-(16-13))+71)"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression \"(\" (expression (expression \"(\" (expression (expression \"51\") \"-\" (expression \"(\" (expression (expression \"16\") \"-\" (expression \"13\")) \")\")) \")\") \"+\" (expression \"71\")) \")\") <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (6, "(", 0, 1, 1, 0, 0),
    (6, "(", 1, 2, 1, 1, 0),
    (8, "51", 2, 4, 1, 2, 0),
    (5, "-", 4, 5, 1, 4, 0),
    (6, "(", 5, 6, 1, 5, 0),
    (8, "16", 6, 8, 1, 6, 0),
    (5, "-", 8, 9, 1, 8, 0),
    (8, "13", 9, 11, 1, 9, 0),
    (7, ")", 11, 12, 1, 11, 0),
    (7, ")", 12, 13, 1, 12, 0),
    (4, "+", 13, 14, 1, 13, 0),
    (8, "71", 14, 16, 1, 14, 0),
    (7, ")", 16, 17, 1, 16, 0),
    (-1, "<EOF>", 17, 17, 1, 17, 0),
  ])
}

///|
