    (4, "a", 0, 1, 1, 0, 0),
    (1, ",", 1, 2, 1, 1, 0),
    (4, "b", 2, 3, 1, 2, 0),
    (2, "\n", 3, 4, 1, 3, 0),
    (-1, "<EOF>", 4, 4, 2, 0, 0),
  ])
}

