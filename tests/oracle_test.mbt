///|
test "Java oracle Json 000" {
  let grammar = @json.grammar()
  let source = "{}"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (object \"{\" \"}\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "{", 0, 1, 1, 0, 0),
    (6, "}", 1, 2, 1, 1, 0),
    (-1, "<EOF>", 2, 2, 1, 2, 0),
  ])
}

