///|
test "Java oracle Json 070" {
  let grammar = @json.grammar()
  let source = "[\n  {\n    \"key0\": {\n      \"key0\": false\n    },\n    \"key1\": true\n  },\n  8212.0,\n  \"MoonANTLR\"\n]"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (array \"[\" (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value \"false\")) \"}\"))) \",\" (pair \"\\\"key1\\\"\" \":\" (value \"true\")) \"}\")) \",\" (value \"8212.0\") \",\" (value \"\\\"MoonANTLR\\\"\") \"]\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (8, "[", 0, 1, 1, 0, 0),
    (4, "{", 4, 5, 2, 2, 0),
    (10, "\"key0\"", 10, 16, 3, 4, 0),
    (7, ":", 16, 17, 3, 10, 0),
    (4, "{", 18, 19, 3, 12, 0),
    (10, "\"key0\"", 26, 32, 4, 6, 0),
    (7, ":", 32, 33, 4, 12, 0),
    (2, "false", 34, 39, 4, 14, 0),
    (6, "}", 44, 45, 5, 4, 0),
    (5, ",", 45, 46, 5, 5, 0),
    (10, "\"key1\"", 51, 57, 6, 4, 0),
    (7, ":", 57, 58, 6, 10, 0),
    (1, "true", 59, 63, 6, 12, 0),
    (6, "}", 66, 67, 7, 2, 0),
    (5, ",", 67, 68, 7, 3, 0),
    (11, "8212.0", 71, 77, 8, 2, 0),
    (5, ",", 77, 78, 8, 8, 0),
    (10, "\"MoonANTLR\"", 81, 92, 9, 2, 0),
    (9, "]", 93, 94, 10, 0, 0),
    (-1, "<EOF>", 94, 94, 10, 1, 0),
  ])
}

