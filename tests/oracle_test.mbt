///|
test "Java oracle Typed 011" {
  let grammar = @typed.grammar()
  let source = "x=(((71*9)-22)*1)"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (entry \"x\" \"=\" (expression \"(\" (expression (expression \"(\" (expression (expression \"(\" (expression (expression \"71\") \"*\" (expression \"9\")) \")\") \"-\" (expression \"22\")) \")\") \"*\" (expression \"1\")) \")\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (10, "x", 0, 1, 1, 0, 0),
    (2, "=", 1, 2, 1, 1, 0),
    (8, "(", 2, 3, 1, 2, 0),
    (8, "(", 3, 4, 1, 3, 0),
    (8, "(", 4, 5, 1, 4, 0),
    (11, "71", 5, 7, 1, 5, 0),
    (4, "*", 7, 8, 1, 7, 0),
    (11, "9", 8, 9, 1, 8, 0),
    (9, ")", 9, 10, 1, 9, 0),
    (7, "-", 10, 11, 1, 10, 0),
    (11, "22", 11, 13, 1, 11, 0),
    (9, ")", 13, 14, 1, 13, 0),
    (4, "*", 14, 15, 1, 14, 0),
    (11, "1", 15, 16, 1, 15, 0),
    (9, ")", 16, 17, 1, 16, 0),
    (-1, "<EOF>", 17, 17, 1, 17, 0),
  ])
}

///|
test "Java oracle Typed 012" {
  let grammar = @typed.grammar()
  let source = "x=(2*(3/56))"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (entry \"x\" \"=\" (expression \"(\" (expression (expression \"2\") \"*\" (expression \"(\" (expression (expression \"3\") \"/\" (expression \"56\")) \")\")) \")\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (10, "x", 0, 1, 1, 0, 0),
    (2, "=", 1, 2, 1, 1, 0),
    (8, "(", 2, 3, 1, 2, 0),
    (11, "2", 3, 4, 1, 3, 0),
    (4, "*", 4, 5, 1, 4, 0),
    (8, "(", 5, 6, 1, 5, 0),
    (11, "3", 6, 7, 1, 6, 0),
    (5, "/", 7, 8, 1, 7, 0),
    (11, "56", 8, 10, 1, 8, 0),
    (9, ")", 10, 11, 1, 10, 0),
    (9, ")", 11, 12, 1, 11, 0),
    (-1, "<EOF>", 12, 12, 1, 12, 0),
  ])
}

///|
