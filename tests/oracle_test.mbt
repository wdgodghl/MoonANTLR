  let source = "alpha beta"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document \"alpha\" \"beta\" <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (3, "alpha", 0, 5, 1, 0, 0),
    (3, "beta", 6, 10, 1, 6, 0),
    (-1, "<EOF>", 10, 10, 1, 10, 0),
  ])
}

