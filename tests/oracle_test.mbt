///|
test "Java oracle Json 050" {
  let grammar = @json.grammar()
  let source = "[\n  false,\n  [\n    {\n      \"key0\": \"MoonANTLR\",\n      \"key1\": \"line\\n\\ttab\"\n    },\n    null,\n    [\n      false,\n      false,\n      \"quote\\\"slash\\\\\"\n    ],\n    {\n      \"key0\": 385.3,\n      \"key1\": false,\n      \"key2\": -774.0\n    }\n  ]\n]"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (array \"[\" (value \"false\") \",\" (value (array \"[\" (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value \"\\\"MoonANTLR\\\"\")) \",\" (pair \"\\\"key1\\\"\" \":\" (value \"\\\"line\\\\n\\\\ttab\\\"\")) \"}\")) \",\" (value \"null\") \",\" (value (array \"[\" (value \"false\") \",\" (value \"false\") \",\" (value \"\\\"quote\\\\\\\"slash\\\\\\\\\\\"\") \"]\")) \",\" (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value \"385.3\")) \",\" (pair \"\\\"key1\\\"\" \":\" (value \"false\")) \",\" (pair \"\\\"key2\\\"\" \":\" (value \"-774.0\")) \"}\")) \"]\")) \"]\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (8, "[", 0, 1, 1, 0, 0),
    (2, "false", 4, 9, 2, 2, 0),
    (5, ",", 9, 10, 2, 7, 0),
    (8, "[", 13, 14, 3, 2, 0),
    (4, "{", 19, 20, 4, 4, 0),
    (10, "\"key0\"", 27, 33, 5, 6, 0),
    (7, ":", 33, 34, 5, 12, 0),
    (10, "\"MoonANTLR\"", 35, 46, 5, 14, 0),
    (5, ",", 46, 47, 5, 25, 0),
    (10, "\"key1\"", 54, 60, 6, 6, 0),
    (7, ":", 60, 61, 6, 12, 0),
    (10, "\"line\\n\\ttab\"", 62, 75, 6, 14, 0),
    (6, "}", 80, 81, 7, 4, 0),
    (5, ",", 81, 82, 7, 5, 0),
    (3, "null", 87, 91, 8, 4, 0),
    (5, ",", 91, 92, 8, 8, 0),
    (8, "[", 97, 98, 9, 4, 0),
    (2, "false", 105, 110, 10, 6, 0),
    (5, ",", 110, 111, 10, 11, 0),
    (2, "false", 118, 123, 11, 6, 0),
    (5, ",", 123, 124, 11, 11, 0),
    (10, "\"quote\\\"slash\\\\\"", 131, 147, 12, 6, 0),
    (9, "]", 152, 153, 13, 4, 0),
    (5, ",", 153, 154, 13, 5, 0),
    (4, "{", 159, 160, 14, 4, 0),
    (10, "\"key0\"", 167, 173, 15, 6, 0),
    (7, ":", 173, 174, 15, 12, 0),
    (11, "385.3", 175, 180, 15, 14, 0),
    (5, ",", 180, 181, 15, 19, 0),
    (10, "\"key1\"", 188, 194, 16, 6, 0),
    (7, ":", 194, 195, 16, 12, 0),
    (2, "false", 196, 201, 16, 14, 0),
    (5, ",", 201, 202, 16, 19, 0),
    (10, "\"key2\"", 209, 215, 17, 6, 0),
    (7, ":", 215, 216, 17, 12, 0),
    (11, "-774.0", 217, 223, 17, 14, 0),
    (6, "}", 228, 229, 18, 4, 0),
    (9, "]", 232, 233, 19, 2, 0),
    (9, "]", 234, 235, 20, 0, 0),
    (-1, "<EOF>", 235, 235, 20, 1, 0),
  ])
}

