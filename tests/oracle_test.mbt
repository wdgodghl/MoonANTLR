///|
test "Java oracle Arithmetic 046" {
  let grammar = @arithmetic.grammar()
  let source = "(5*((77+17)/(50/14)))"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (term (factor \"(\" (expression (term (factor \"5\") \"*\" (factor \"(\" (expression (term (factor \"(\" (expression (term (factor \"77\")) \"+\" (term (factor \"17\"))) \")\") \"/\" (factor \"(\" (expression (term (factor \"50\") \"/\" (factor \"14\"))) \")\"))) \")\"))) \")\"))) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (5, "(", 0, 1, 1, 0, 0),
    (7, "5", 1, 2, 1, 1, 0),
    (3, "*", 2, 3, 1, 2, 0),
    (5, "(", 3, 4, 1, 3, 0),
    (5, "(", 4, 5, 1, 4, 0),
    (7, "77", 5, 7, 1, 5, 0),
    (1, "+", 7, 8, 1, 7, 0),
    (7, "17", 8, 10, 1, 8, 0),
    (6, ")", 10, 11, 1, 10, 0),
    (4, "/", 11, 12, 1, 11, 0),
    (5, "(", 12, 13, 1, 12, 0),
    (7, "50", 13, 15, 1, 13, 0),
    (4, "/", 15, 16, 1, 15, 0),
    (7, "14", 16, 18, 1, 16, 0),
    (6, ")", 18, 19, 1, 18, 0),
    (6, ")", 19, 20, 1, 19, 0),
    (6, ")", 20, 21, 1, 20, 0),
    (-1, "<EOF>", 21, 21, 1, 21, 0),
  ])
}

