///|
test "Java oracle Json 014" {
  let grammar = @json.grammar()
  let source = "{\n  \"key0\": [\n    true,\n    null\n  ],\n  \"key1\": -120.9,\n  \"key2\": null\n}"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value (array \"[\" (value \"true\") \",\" (value \"null\") \"]\"))) \",\" (pair \"\\\"key1\\\"\" \":\" (value \"-120.9\")) \",\" (pair \"\\\"key2\\\"\" \":\" (value \"null\")) \"}\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "{", 0, 1, 1, 0, 0),
    (10, "\"key0\"", 4, 10, 2, 2, 0),
    (7, ":", 10, 11, 2, 8, 0),
    (8, "[", 12, 13, 2, 10, 0),
    (1, "true", 18, 22, 3, 4, 0),
    (5, ",", 22, 23, 3, 8, 0),
    (3, "null", 28, 32, 4, 4, 0),
    (9, "]", 35, 36, 5, 2, 0),
    (5, ",", 36, 37, 5, 3, 0),
    (10, "\"key1\"", 40, 46, 6, 2, 0),
    (7, ":", 46, 47, 6, 8, 0),
    (11, "-120.9", 48, 54, 6, 10, 0),
    (5, ",", 54, 55, 6, 16, 0),
    (10, "\"key2\"", 58, 64, 7, 2, 0),
    (7, ":", 64, 65, 7, 8, 0),
    (3, "null", 66, 70, 7, 10, 0),
    (6, "}", 71, 72, 8, 0, 0),
    (-1, "<EOF>", 72, 72, 8, 1, 0),
  ])
}

