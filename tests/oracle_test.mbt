  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value (array \"[\" (value (array \"[\" (value \"162.5\") \",\" (value \"false\") \",\" (value \"\\\"MoonANTLR\\\"\") \"]\")) \"]\"))) \"}\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "{", 0, 1, 1, 0, 0),
    (10, "\"key0\"", 1, 7, 1, 1, 0),
    (7, ":", 7, 8, 1, 7, 0),
    (8, "[", 9, 10, 1, 9, 0),
    (8, "[", 10, 11, 1, 10, 0),
    (11, "162.5", 11, 16, 1, 11, 0),
    (5, ",", 16, 17, 1, 16, 0),
    (2, "false", 18, 23, 1, 18, 0),
    (5, ",", 23, 24, 1, 23, 0),
    (10, "\"MoonANTLR\"", 25, 36, 1, 25, 0),
    (9, "]", 36, 37, 1, 36, 0),
    (9, "]", 37, 38, 1, 37, 0),
    (6, "}", 38, 39, 1, 38, 0),
    (-1, "<EOF>", 39, 39, 1, 39, 0),
  ])
}

