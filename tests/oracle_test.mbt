///|
test "Java oracle Typed 000" {
  let grammar = @typed.grammar()
  let source = "x=1"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (entry \"x\" \"=\" (expression \"1\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (10, "x", 0, 1, 1, 0, 0),
    (2, "=", 1, 2, 1, 1, 0),
    (11, "1", 2, 3, 1, 2, 0),
    (-1, "<EOF>", 3, 3, 1, 3, 0),
  ])
}

///|
test "Java oracle Typed 001" {
  let grammar = @typed.grammar()
  let source = "x=1+2*3; y=2^3^4 note;"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (entry \"x\" \"=\" (expression (expression \"1\") \"+\" (expression (expression \"2\") \"*\" (expression \"3\")))) \";\" (entry \"y\" \"=\" (expression (expression \"2\") \"^\" (expression (expression \"3\") \"^\" (expression \"4\"))) \"note\") \";\" <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (10, "x", 0, 1, 1, 0, 0),
    (2, "=", 1, 2, 1, 1, 0),
    (11, "1", 2, 3, 1, 2, 0),
    (6, "+", 3, 4, 1, 3, 0),
    (11, "2", 4, 5, 1, 4, 0),
    (4, "*", 5, 6, 1, 5, 0),
    (11, "3", 6, 7, 1, 6, 0),
    (1, ";", 7, 8, 1, 7, 0),
    (10, "y", 9, 10, 1, 9, 0),
    (2, "=", 10, 11, 1, 10, 0),
    (11, "2", 11, 12, 1, 11, 0),
    (3, "^", 12, 13, 1, 12, 0),
    (11, "3", 13, 14, 1, 13, 0),
    (3, "^", 14, 15, 1, 14, 0),
    (11, "4", 15, 16, 1, 15, 0),
    (10, "note", 17, 21, 1, 17, 0),
    (1, ";", 21, 22, 1, 21, 0),
    (-1, "<EOF>", 22, 22, 1, 22, 0),
  ])
}

///|
test "Java oracle Typed 002" {
  let grammar = @typed.grammar()
  let source = "x=(1+2)*3"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (entry \"x\" \"=\" (expression (expression \"(\" (expression (expression \"1\") \"+\" (expression \"2\")) \")\") \"*\" (expression \"3\"))) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (10, "x", 0, 1, 1, 0, 0),
    (2, "=", 1, 2, 1, 1, 0),
    (8, "(", 2, 3, 1, 2, 0),
    (11, "1", 3, 4, 1, 3, 0),
    (6, "+", 4, 5, 1, 4, 0),
    (11, "2", 5, 6, 1, 5, 0),
    (9, ")", 6, 7, 1, 6, 0),
    (4, "*", 7, 8, 1, 7, 0),
    (11, "3", 8, 9, 1, 8, 0),
    (-1, "<EOF>", 9, 9, 1, 9, 0),
  ])
}

