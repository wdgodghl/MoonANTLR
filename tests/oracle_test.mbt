test "Java oracle Json 080" {
  let grammar = @json.grammar()
  let source = "{\n  \"key0\": [\n    [\n      true,\n      null,\n      \"中文😀\",\n      \"MoonANTLR\"\n    ]\n  ],\n  \"key1\": null,\n  \"key2\": true\n}"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value (array \"[\" (value (array \"[\" (value \"true\") \",\" (value \"null\") \",\" (value \"\\\"中文😀\\\"\") \",\" (value \"\\\"MoonANTLR\\\"\") \"]\")) \"]\"))) \",\" (pair \"\\\"key1\\\"\" \":\" (value \"null\")) \",\" (pair \"\\\"key2\\\"\" \":\" (value \"true\")) \"}\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "{", 0, 1, 1, 0, 0),
    (10, "\"key0\"", 4, 10, 2, 2, 0),
    (7, ":", 10, 11, 2, 8, 0),
    (8, "[", 12, 13, 2, 10, 0),
    (8, "[", 18, 19, 3, 4, 0),
    (1, "true", 26, 30, 4, 6, 0),
    (5, ",", 30, 31, 4, 10, 0),
    (3, "null", 38, 42, 5, 6, 0),
    (5, ",", 42, 43, 5, 10, 0),
    (10, "\"中文😀\"", 50, 55, 6, 6, 0),
    (5, ",", 55, 56, 6, 11, 0),
    (10, "\"MoonANTLR\"", 63, 74, 7, 6, 0),
    (9, "]", 79, 80, 8, 4, 0),
    (9, "]", 83, 84, 9, 2, 0),
    (5, ",", 84, 85, 9, 3, 0),
    (10, "\"key1\"", 88, 94, 10, 2, 0),
    (7, ":", 94, 95, 10, 8, 0),
    (3, "null", 96, 100, 10, 10, 0),
    (5, ",", 100, 101, 10, 14, 0),
    (10, "\"key2\"", 104, 110, 11, 2, 0),
    (7, ":", 110, 111, 11, 8, 0),
    (1, "true", 112, 116, 11, 10, 0),
    (6, "}", 117, 118, 12, 0, 0),
    (-1, "<EOF>", 118, 118, 12, 1, 0),
  ])
}

