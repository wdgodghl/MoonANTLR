    (6, ")", 18, 19, 1, 18, 0),
    (6, ")", 19, 20, 1, 19, 0),
    (6, ")", 20, 21, 1, 20, 0),
    (-1, "<EOF>", 21, 21, 1, 21, 0),
  ])
}

