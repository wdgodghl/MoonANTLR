}

///|
test "Java oracle Csv 001" {
  let grammar = @csv_grammar.grammar()
  let source = "a,b"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (row (field \"a\") \",\" (field \"b\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "a", 0, 1, 1, 0, 0),
    (1, ",", 1, 2, 1, 1, 0),
    (4, "b", 2, 3, 1, 2, 0),
    (-1, "<EOF>", 3, 3, 1, 3, 0),
  ])
}

