    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (3, "\"with,comma\"", 0, 12, 1, 0, 0),
    (1, ",", 12, 13, 1, 12, 0),
    (3, "\"with,comma\"", 13, 25, 1, 13, 0),
    (1, ",", 25, 26, 1, 25, 0),
    (4, "中文😀", 26, 29, 1, 26, 0),
    (2, "\r\n", 29, 31, 1, 29, 0),
    (1, ",", 31, 32, 2, 0, 0),
    (3, "\"a\"\"b\"", 32, 38, 2, 1, 0),
    (1, ",", 38, 39, 2, 7, 0),
    (4, "中文😀", 39, 42, 2, 8, 0),
    (2, "\r\n", 42, 44, 2, 11, 0),
    (-1, "<EOF>", 44, 44, 3, 0, 0),
  ])
}

///|
