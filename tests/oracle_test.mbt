  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value \"null\")) \",\" (pair \"\\\"key1\\\"\" \":\" (value \"null\")) \"}\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "{", 0, 1, 1, 0, 0),
    (10, "\"key0\"", 4, 10, 2, 2, 0),
    (7, ":", 10, 11, 2, 8, 0),
    (3, "null", 12, 16, 2, 10, 0),
    (5, ",", 16, 17, 2, 14, 0),
    (10, "\"key1\"", 20, 26, 3, 2, 0),
    (7, ":", 26, 27, 3, 8, 0),
    (3, "null", 28, 32, 3, 10, 0),
    (6, "}", 33, 34, 4, 0, 0),
    (-1, "<EOF>", 34, 34, 4, 1, 0),
  ])
}

