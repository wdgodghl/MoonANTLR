///|
test "Java oracle Json 019" {
  let grammar = @json.grammar()
  let source = "{\n  \"key0\": {},\n  \"key1\": \"quote\\\"slash\\\\\",\n  \"key2\": \"line\\n\\ttab\"\n}"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (object \"{\" (pair \"\\\"key0\\\"\" \":\" (value (object \"{\" \"}\"))) \",\" (pair \"\\\"key1\\\"\" \":\" (value \"\\\"quote\\\\\\\"slash\\\\\\\\\\\"\")) \",\" (pair \"\\\"key2\\\"\" \":\" (value \"\\\"line\\\\n\\\\ttab\\\"\")) \"}\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (4, "{", 0, 1, 1, 0, 0),
    (10, "\"key0\"", 4, 10, 2, 2, 0),
    (7, ":", 10, 11, 2, 8, 0),
    (4, "{", 12, 13, 2, 10, 0),
    (6, "}", 13, 14, 2, 11, 0),
    (5, ",", 14, 15, 2, 12, 0),
    (10, "\"key1\"", 18, 24, 3, 2, 0),
    (7, ":", 24, 25, 3, 8, 0),
    (10, "\"quote\\\"slash\\\\\"", 26, 42, 3, 10, 0),
    (5, ",", 42, 43, 3, 26, 0),
    (10, "\"key2\"", 46, 52, 4, 2, 0),
    (7, ":", 52, 53, 4, 8, 0),
    (10, "\"line\\n\\ttab\"", 54, 67, 4, 10, 0),
    (6, "}", 68, 69, 5, 0, 0),
    (-1, "<EOF>", 69, 69, 5, 1, 0),
  ])
}

