  @debug.assert_eq(actual, [
    (1, "p", 0, 1, 1, 0, 0),
    (6, "a", 2, 3, 1, 2, 0),
    (2, "x", 4, 5, 1, 4, 0),
    (2, "x", 6, 7, 1, 6, 0),
    (3, ";", 7, 8, 1, 7, 0),
    (-1, "<EOF>", 8, 8, 1, 8, 0),
  ])
}

