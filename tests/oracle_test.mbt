///|
test "Java oracle Arithmetic 000" {
  let grammar = @arithmetic.grammar()
  let source = "1+2*3"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (term (factor \"1\")) \"+\" (term (factor \"2\") \"*\" (factor \"3\"))) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (7, "1", 0, 1, 1, 0, 0),
    (1, "+", 1, 2, 1, 1, 0),
    (7, "2", 2, 3, 1, 2, 0),
    (3, "*", 3, 4, 1, 3, 0),
    (7, "3", 4, 5, 1, 4, 0),
    (-1, "<EOF>", 5, 5, 1, 5, 0),
  ])
}

///|
test "Java oracle Arithmetic 001" {
  let grammar = @arithmetic.grammar()
  let source = "(1+2)*3"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (term (factor \"(\" (expression (term (factor \"1\")) \"+\" (term (factor \"2\"))) \")\") \"*\" (factor \"3\"))) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (5, "(", 0, 1, 1, 0, 0),
    (7, "1", 1, 2, 1, 1, 0),
    (1, "+", 2, 3, 1, 2, 0),
    (7, "2", 3, 4, 1, 3, 0),
    (6, ")", 4, 5, 1, 4, 0),
    (3, "*", 5, 6, 1, 5, 0),
    (7, "3", 6, 7, 1, 6, 0),
    (-1, "<EOF>", 7, 7, 1, 7, 0),
  ])
}

///|
test "Java oracle Arithmetic 002" {
  let grammar = @arithmetic.grammar()
  let source = " 12 / 3 - 2\n"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (term (factor \"12\") \"/\" (factor \"3\")) \"-\" (term (factor \"2\"))) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (7, "12", 1, 3, 1, 1, 0),
    (4, "/", 4, 5, 1, 4, 0),
    (7, "3", 6, 7, 1, 6, 0),
    (2, "-", 8, 9, 1, 8, 0),
    (7, "2", 10, 11, 1, 10, 0),
    (-1, "<EOF>", 12, 12, 2, 0, 0),
  ])
}

///|
test "Java oracle Arithmetic 003" {
  let grammar = @arithmetic.grammar()
  let source = "1-2-3"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (term (factor \"1\")) \"-\" (term (factor \"2\")) \"-\" (term (factor \"3\"))) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (7, "1", 0, 1, 1, 0, 0),
    (2, "-", 1, 2, 1, 1, 0),
    (7, "2", 2, 3, 1, 2, 0),
    (2, "-", 3, 4, 1, 3, 0),
    (7, "3", 4, 5, 1, 4, 0),
    (-1, "<EOF>", 5, 5, 1, 5, 0),
  ])
}

///|
test "Java oracle Arithmetic 004" {
  let grammar = @arithmetic.grammar()
  let source = "1/(2+3)"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (expression (term (factor \"1\") \"/\" (factor \"(\" (expression (term (factor \"2\")) \"+\" (term (factor \"3\"))) \")\"))) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
