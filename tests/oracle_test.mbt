    (8, "(", 4, 5, 1, 4, 0),
    (11, "11", 5, 7, 1, 5, 0),
    (5, "/", 7, 8, 1, 7, 0),
    (11, "36", 8, 10, 1, 8, 0),
    (9, ")", 10, 11, 1, 10, 0),
    (7, "-", 11, 12, 1, 11, 0),
    (11, "27", 12, 14, 1, 12, 0),
    (9, ")", 14, 15, 1, 14, 0),
    (4, "*", 15, 16, 1, 15, 0),
    (8, "(", 16, 17, 1, 16, 0),
    (8, "(", 17, 18, 1, 17, 0),
    (11, "72", 18, 20, 1, 18, 0),
    (7, "-", 20, 21, 1, 20, 0),
    (11, "47", 21, 23, 1, 21, 0),
    (9, ")", 23, 24, 1, 23, 0),
    (7, "-", 24, 25, 1, 24, 0),
    (11, "46", 25, 27, 1, 25, 0),
    (9, ")", 27, 28, 1, 27, 0),
    (9, ")", 28, 29, 1, 28, 0),
    (-1, "<EOF>", 29, 29, 1, 29, 0),
