///|
test "Java oracle Json 038" {
  let grammar = @json.grammar()
  let source = "[\n  -48.77,\n  \"中文😀\",\n  [\n    \"中文😀\",\n    490.8\n  ],\n  \"MoonANTLR\"\n]"
  assert_eq(
    grammar.parse(source).to_sexpr(),
    "(document (value (array \"[\" (value \"-48.77\") \",\" (value \"\\\"中文😀\\\"\") \",\" (value (array \"[\" (value \"\\\"中文😀\\\"\") \",\" (value \"490.8\") \"]\")) \",\" (value \"\\\"MoonANTLR\\\"\") \"]\")) <EOF>)",
  )
  let actual = grammar
    .tokenize(source)
    .map(t => (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel))
  @debug.assert_eq(actual, [
    (8, "[", 0, 1, 1, 0, 0),
    (11, "-48.77", 4, 10, 2, 2, 0),
    (5, ",", 10, 11, 2, 8, 0),
    (10, "\"中文😀\"", 14, 19, 3, 2, 0),
    (5, ",", 19, 20, 3, 7, 0),
    (8, "[", 23, 24, 4, 2, 0),
    (10, "\"中文😀\"", 29, 34, 5, 4, 0),
    (5, ",", 34, 35, 5, 9, 0),
    (11, "490.8", 40, 45, 6, 4, 0),
    (9, "]", 48, 49, 7, 2, 0),
    (5, ",", 49, 50, 7, 3, 0),
    (10, "\"MoonANTLR\"", 53, 64, 8, 2, 0),
    (9, "]", 65, 66, 9, 0, 0),
    (-1, "<EOF>", 66, 66, 9, 1, 0),
  ])
}

