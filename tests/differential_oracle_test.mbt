    "a foo foo",
    start_rule=4,
    prediction_mode=@runtime.LL_EXACT_AMBIG_DETECTION,
    semantics=semantic_differential_bindings(false, trace),
  )
  assert_eq(
    parsed.tree.to_sexpr(),
    "(local \"a\" \"foo\" (error \"foo\") <EOF>)",
  )
  @debug.assert_eq(
    parsed.diagnostics.map(d => (d.line.unwrap(), d.column.unwrap())),
    [(1, 6)],
  )
  assert_eq(parsed.next_token.kind, -1)
  assert_eq(parsed.next_token.text, "<EOF>")
  let expected : Json = @reference_json.parse(
    "[{\"kind\":\"attempting_full_context\",\"decision\":2,\"start\":0,\"stop\":2,\"exact\":false,\"alternatives\":[1,2],\"prediction\":0},{\"kind\":\"ambiguity\",\"decision\":2,\"start\":0,\"stop\":2,\"exact\":true,\"alternatives\":[1,2],\"prediction\":0}]",
  )
  @debug.assert_eq(
    Json::array(parsed.prediction_events.map(event => event.to_json())),
    expected,
  )
  assert_eq(trace.to_string(), "6:")
}

