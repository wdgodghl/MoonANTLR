///|
test "differential semantic entry False SLL 000" {
  let trace = StringBuilder()
  let parsed = @semantic_differential.grammar().parse_default(
    "foo",
    start_rule=0,
    prediction_mode=@runtime.SLL,
    semantics=semantic_differential_bindings(false, trace),
  )
  assert_eq(parsed.tree.to_sexpr(), "(entry (right \"foo\") <EOF>)")
  @debug.assert_eq(
    parsed.diagnostics.map(d => (d.line.unwrap(), d.column.unwrap())),
    [],
  )
  assert_eq(parsed.next_token.kind, -1)
  assert_eq(parsed.next_token.text, "<EOF>")
  let expected : Json = @reference_json.parse("[]")
  @debug.assert_eq(
    Json::array(parsed.prediction_events.map(event => event.to_json())),
    expected,
  )
  assert_eq(trace.to_string(), "1:2:2:")
}

