///|
test "differential contexts LL 008" {
  let parsed = @differential.grammar().parse_default(
    "a b b",
    start_rule=12,
    prediction_mode=@runtime.LL,
  )
  assert_eq(
    parsed.tree.to_sexpr(),
    "(contexts \"a\" (inner \"b\") \"b\" <EOF>)",
  )
  @debug.assert_eq(
    parsed.diagnostics.map(d => (d.line.unwrap(), d.column.unwrap())),
    [],
  )
  assert_eq(parsed.next_token.kind, -1)
  assert_eq(parsed.next_token.text, "<EOF>")
  let expected : Json = @reference_json.parse(
    "[{\"kind\":\"attempting_full_context\",\"decision\":12,\"start\":2,\"stop\":5,\"exact\":false,\"alternatives\":[1,2],\"prediction\":0},{\"kind\":\"context_sensitivity\",\"decision\":12,\"start\":2,\"stop\":4,\"exact\":false,\"alternatives\":[],\"prediction\":1}]",
  )
  @debug.assert_eq(
    Json::array(parsed.prediction_events.map(event => event.to_json())),
    expected,
  )
}

