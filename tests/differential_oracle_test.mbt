test "differential contexts SLL 047" {
  let parsed = @differential.grammar().parse_default(
    "y x x c",
    start_rule=12,
    prediction_mode=@runtime.SLL,
  )
  assert_eq(
    parsed.tree.to_sexpr(),
    "(contexts (error \"y\") (error \"x\") (error \"x\") (error \"c\"))",
  )
  @debug.assert_eq(
    parsed.diagnostics.map(d => (d.line.unwrap(), d.column.unwrap())),
    [(1, 0)],
  )
  assert_eq(parsed.next_token.kind, -1)
  assert_eq(parsed.next_token.text, "<EOF>")
  let expected : Json = @reference_json.parse("[]")
  @debug.assert_eq(
    Json::array(parsed.prediction_events.map(event => event.to_json())),
    expected,
  )
}

///|
test "differential contexts SLL 048" {
  let parsed = @differential.grammar().parse_default(
    "y a a c",
    start_rule=12,
    prediction_mode=@runtime.SLL,
  )
  assert_eq(
    parsed.tree.to_sexpr(),
    "(contexts (error \"y\") \"a\" (inner) (error \"a\") (error \"c\"))",
  )
  @debug.assert_eq(
    parsed.diagnostics.map(d => (d.line.unwrap(), d.column.unwrap())),
    [(1, 0), (1, 4)],
  )
  assert_eq(parsed.next_token.kind, -1)
  assert_eq(parsed.next_token.text, "<EOF>")
  let expected : Json = @reference_json.parse("[]")
  @debug.assert_eq(
    Json::array(parsed.prediction_events.map(event => event.to_json())),
    expected,
  )
}

