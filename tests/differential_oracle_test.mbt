///|
test "differential Lexer 074" {
  let lexed = @runtime.deserialize(@unicode_modes_lexer.lexer_data()).tokenize_recovering(
    "/*x*/\\//x\n😀\r\n\"a\\\"b\"",
  )
  @debug.assert_eq(
    lexed.tokens.map(t => {
      (t.kind, t.text, t.start, t.end, t.line, t.column, t.channel)
    }),
    [
      (4, "/*x*/", 0, 5, 1, 0, 1),
      (6, "\n", 9, 10, 1, 9, 1),
      (2, "😀", 10, 11, 2, 0, 0),
      (6, "\r\n", 11, 13, 2, 1, 1),
      (1, "\"a\\\"b\"", 13, 19, 3, 0, 0),
      (-1, "<EOF>", 19, 19, 3, 6, 0),
    ],
  )
  @debug.assert_eq(
    lexed.errors.map(error => {
      match error {
        @runtime.LexicalError(line, col, _) => (line, col)
        _ => (-1, -1)
      }
    }),
    [(1, 5)],
  )
}

